# API server environment. Copy to .env and fill in what you need.
# Every capability is independent: unset what you don't use.
# NOTHING here may ever be named VITE_* — that prefix ships in the bundle.

# HTTP port the server listens on (Vite dev proxies /api to 8787).
PORT=8787

# Origin allowed by CORS. Dev default is the Vite dev server.
LWAG_ALLOWED_ORIGIN=http://localhost:5173

# ── AI scene intents ─────────────────────────────────────────────────────
# Explicit provider: 'anthropic' | 'ollama'. Unset = anthropic when a key
# is present, otherwise local ollama.
#LWAG_AI_PROVIDER=anthropic

# Hosted Claude (needs ANTHROPIC_API_KEY).
ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-opus-5

# Local Ollama (no key, no quota, no network). Model must be pulled.
#OLLAMA_HOST=http://127.0.0.1:11434
#OLLAMA_MODEL=qwen3:8b
# Set to 1 only if OLLAMA_MODEL actually accepts images (llava, qwen2.5-vl).
# Text-only models reject them.
#OLLAMA_VISION=0

# ── Project sync ─────────────────────────────────────────────────────────
# Mounts /api/projects/* only when set. Run Postgres via ../docker-compose.yml.
#DATABASE_URL=postgres://vibrix:vibrix@localhost:5432/vibrix

# Comma-separated bearer tokens for the development auth stand-in.
# NOT a production identity system — see README ("Auth is a dev stand-in").
#LWAG_API_TOKENS=dev-token-1,dev-token-2
